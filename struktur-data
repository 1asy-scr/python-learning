    <script>
      // Kunci jawaban & penjelasan kuis diselaraskan dengan standar format kuis
      const jawabanBenar = {
        q1: 'b',
        q2: 'c',
        q3: 'c',
        q4: 'd',
        q5: 'b',
        q6: 'b',
        q7: 'c',
      };

      const penjelasan = {
        q1: 'List merupakan struktur data yang dapat menyimpan banyak elemen dan dapat diubah setelah dibuat.',
        q2: 'Tuple bersifat immutable, artinya elemen di dalamnya tidak dapat diubah setelah tuple dibuat.',
        q3: 'Set digunakan untuk menyimpan elemen unik. Jika terdapat elemen duplikat, hanya satu yang akan disimpan.',
        q4: 'Dictionary menyimpan data dalam pasangan key dan value sehingga setiap nilai dapat diakses melalui key.',
        q5: 'Indeks list dimulai dari 0. Dengan demikian, indeks 1 menunjukkan elemen kedua, yaitu Jeruk.',
        q6: 'Method append() digunakan untuk menambahkan elemen baru pada bagian akhir list.',
        q7: 'Fungsi len() digunakan untuk menghitung jumlah elemen dalam suatu struktur data.',
      };

      const form = document.getElementById('quiz-form');
      const jumlahSoal = 7;

      function perbaruiProgress() {
        let terjawab = 0;

        for (let i = 1; i <= jumlahSoal; i++) {
          if (form.querySelector(`input[name="q${i}"]:checked`)) {
            terjawab++;
          }
        }

        document.getElementById(
          'quiz-count'
        ).textContent = `${terjawab}/${jumlahSoal} dijawab`;

        document.getElementById('quiz-progress-bar').style.width = `${
          (terjawab / jumlahSoal) * 100
        }%`;
      }

      form.addEventListener('change', perbaruiProgress);

      document
        .getElementById('check-quiz')
        .addEventListener('click', function () {
          let skor = 0;
          let belumDijawab = [];

          for (let i = 1; i <= jumlahSoal; i++) {
            const pilihan = form.querySelector(`input[name="q${i}"]:checked`);
            const feedback = document.getElementById(`feedback-q${i}`);

            feedback.className = 'quiz-feedback';

            if (!pilihan) {
              belumDijawab.push(i);
              feedback.textContent = 'Belum dijawab.';
              feedback.classList.add('wrong');
              continue;
            }

            if (pilihan.value === jawabanBenar[`q${i}`]) {
              skor++;
              feedback.textContent = 'Benar! ' + penjelasan[`q${i}`];
              feedback.classList.add('correct');
            } else {
              feedback.textContent = 'Belum tepat. ' + penjelasan[`q${i}`];
              feedback.classList.add('wrong');
            }
          }

          if (belumDijawab.length > 0) {
            alert(
              'Masih ada soal yang belum dijawab: ' +
                belumDijawab.join(', ') +
                '. Silakan lengkapi terlebih dahulu.'
            );
            return;
          }

          const nilai = Math.round((skor / jumlahSoal) * 100);

          document.getElementById('quiz-result').style.display = 'block';

          document.getElementById(
            'quiz-score'
          ).textContent = `Jawaban benar: ${skor} dari ${jumlahSoal} soal. Nilai: ${nilai}/100.`;

          let pesan = '';

          if (nilai === 100) {
            pesan = 'Luar biasa! Semua jawabanmu benar. Pertahankan!';
          } else if (nilai >= 80) {
            pesan =
              'Hebat! Kamu sudah memahami struktur data Python dengan baik.';
          } else if (nilai >= 60) {
            pesan = 'Bagus! Pelajari kembali bagian yang belum dikuasai.';
          } else {
            pesan = 'Tetap semangat! Pelajari kembali materi dan coba lagi.';
          }

          document.getElementById('quiz-message').textContent = pesan;

          document.getElementById('check-quiz').style.display = 'none';
          document.getElementById('reset-quiz').style.display = 'inline-block';

          document.getElementById('quiz-result').scrollIntoView({
            behavior: 'smooth',
            block: 'center',
          });
        });

      document
        .getElementById('reset-quiz')
        .addEventListener('click', function () {
          form.reset();

          for (let i = 1; i <= jumlahSoal; i++) {
            const feedback = document.getElementById(`feedback-q${i}`);
            feedback.textContent = '';
            feedback.className = 'quiz-feedback';
          }

          document.getElementById('quiz-result').style.display = 'none';
          document.getElementById('check-quiz').style.display = 'inline-block';
          document.getElementById('reset-quiz').style.display = 'none';

          perbaruiProgress();

          window.scrollTo({
            top: document.querySelector('.quiz-container').offsetTop,
            behavior: 'smooth',
          });
        });

      perbaruiProgress();
    </script>
